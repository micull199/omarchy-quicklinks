#!/bin/bash

# Backend for the Quicklinks Omarchy shell plugin.
#
# Lives inside the plugin folder and is invoked by QuicklinksPanel.qml with an
# absolute path, so it is installed and removed with the plugin and never
# touches PATH.
#
# Every piece of state lives inside the plugin folder, under data/:
#
#   data/applications/<Name>.desktop   the real desktop entry
#   data/icons/<slug>.png              the icon fetched for it
#
# The only things written elsewhere are SYMLINKS in ~/.local/share/applications
# (omarchy-quicklink-<Name>.desktop -> data/applications/<Name>.desktop) and a
# marker-delimited block of rows in the Omarchy menu file, every row guarded by
# `[ -x <this script> ]`. Omarchy runs no hooks on `omarchy plugin remove`; it
# just deletes the folder. When that happens the symlinks dangle, so launchers
# cannot open them and drop them (Quickshell: "Could not open file", skipped),
# and the menu rows' guards fail, so they vanish too. Nothing functional is
# left behind. `uninstall` takes the symlinks and rows away properly.

set -euo pipefail

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
PLUGIN_ID="micull199.quicklinks"

DATA_DIR="${OMARCHY_QUICKLINKS_DATA_DIR:-$PLUGIN_DIR/data}"
ENTRY_DIR="$DATA_DIR/applications"
ICON_DIR="${OMARCHY_QUICKLINKS_ICON_DIR:-$DATA_DIR/icons}"
DESKTOP_DIR="${OMARCHY_QUICKLINKS_DESKTOP_DIR:-$HOME/.local/share/applications}"
LEGACY_ICON_DIR="${OMARCHY_QUICKLINKS_LEGACY_ICON_DIR:-$HOME/.local/share/icons/hicolor/256x256/apps}"
MENU_EXTENSION="${OMARCHY_MENU_EXTENSION:-$HOME/.config/omarchy/extensions/omarchy-menu.jsonc}"

LINK_PREFIX="omarchy-quicklink-"
MARKER="X-Omarchy-Quicklink=true"
PRIVATE_MARKER="X-Omarchy-Quicklink-Private=true"
FALLBACK_ICON="web-browser"

die() {
  echo "$*" >&2
  exit 1
}

is_quicklink() {
  [[ -f $1 ]] && grep -qxF "$MARKER" "$1" 2>/dev/null
}

is_private() {
  grep -qxF "$PRIVATE_MARKER" "$1" 2>/dev/null
}

# The real entry, inside the plugin folder.
entry_file() { printf '%s\n' "$ENTRY_DIR/$1.desktop"; }
# The symlink the launcher sees.
link_file() { printf '%s\n' "$DESKTOP_DIR/$LINK_PREFIX$1.desktop"; }
# Where the icon fetched for a name lands.
icon_file() { printf '%s\n' "$ICON_DIR/$1.png"; }

# Prints the trimmed name on success, so callers use `name=$(validate_name
# "$raw")` and always work with the trimmed form. Control characters (tab,
# newline, CR, ...) are rejected because they cannot survive the desktop entry.
validate_name() {
  local name="$1"
  name=${name#"${name%%[![:space:]]*}"}
  name=${name%"${name##*[![:space:]]}"}
  [[ -n $name ]] || die "a name is required"
  [[ $name != *[[:cntrl:]]* ]] || die "a name cannot contain control characters"
  [[ $name != */* ]] || die "a name cannot contain \"/\""
  [[ $name != .* ]] || die "a name cannot start with a dot"
  printf '%s\n' "$name"
}

# Prints the normalized URL: a bare host gets https:// in front, as
# omarchy-webapp-install does. Spaces are fine because the Exec line quotes the
# URL; control characters are not, since they cannot survive the desktop entry.
validate_url() {
  local url="$1"
  url=${url#"${url%%[![:space:]]*}"}
  url=${url%"${url##*[![:space:]]}"}
  [[ -n $url ]] || die "a URL is required"
  [[ $url != *[[:cntrl:]]* ]] || die "a URL cannot contain control characters"
  [[ $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || url="https://$url"
  printf '%s\n' "$url"
}

safe_icon_name() {
  printf '%s\n' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

url_host() {
  local url="$1"
  url=${url#*://}
  url=${url%%[/?#]*}
  url=${url##*@}
  printf '%s\n' "$url"
}

# True for an icon this plugin fetched (absolute path into ICON_DIR, or the bare
# slug older versions wrote) as opposed to a themed icon the user chose.
is_fetched_icon() { # <icon value> <name>
  local icon="$1" safe
  safe=$(safe_icon_name "$2")
  [[ $icon == "$ICON_DIR"/* || ( -n $safe && $icon == "$safe" ) ]]
}

# ------------------------------------------------------------- Exec quoting
#
# Quoting in an Exec key has two layers. The Exec layer allows \" \` \$ \\
# inside a double-quoted argument and wants a literal % written as %%. The
# desktop-file string layer underneath knows only \s \n \t \r \\, so any
# backslash meant for the Exec layer is written doubled. A URL holding a `"`
# therefore ends up as \\" in the file. Both GLib and desktop-file-validate
# read it back as the raw URL; anything less exact is rejected or mangled.

# Exec layer: one double-quoted argument.
exec_quote() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//\`/\\\`}
  s=${s//\$/\\\$}
  s=${s//%/%%}
  printf '"%s"' "$s"
}

# Desktop-file string layer: every backslash doubled.
file_encode() { printf '%s' "${1//\\/\\\\}"; }

exec_line_for() {
  local url="$1" private="$2" flag=""
  ((private)) && flag="--private "
  printf 'omarchy-launch-browser %s%s\n' "$flag" "$(file_encode "$(exec_quote "$url")")"
}

# Reverse of file_encode. An escape the string layer does not define is kept
# as written, which is exactly what makes entries from the previous version of
# this plugin (single-layer \" and \\) still decode below.
file_decode() {
  local s="$1" out="" i=0 c n
  while ((i < ${#s})); do
    c=${s:i:1}
    if [[ $c == '\' ]] && ((i + 1 < ${#s})); then
      n=${s:i+1:1}
      case $n in
      s) out+=' ' ;;
      n) out+=$'\n' ;;
      t) out+=$'\t' ;;
      r) out+=$'\r' ;;
      '\') out+='\' ;;
      *) out+='\' ; i=$((i - 1)) ;;
      esac
      i=$((i + 2))
    else
      out+=$c
      i=$((i + 1))
    fi
  done
  printf '%s' "$out"
}

# Reverse of exec_quote: strip the quotes, drop the escaping backslashes,
# collapse %%.
exec_unquote() {
  local s="$1" out="" i=0 c
  [[ $s == \"*\" ]] && s=${s:1:${#s}-2}
  while ((i < ${#s})); do
    c=${s:i:1}
    if [[ $c == '\' ]] && ((i + 1 < ${#s})); then
      out+=${s:i+1:1}
      i=$((i + 2))
    elif [[ $c == '%' && ${s:i+1:1} == '%' ]]; then
      out+='%'
      i=$((i + 2))
    else
      out+=$c
      i=$((i + 1))
    fi
  done
  printf '%s\n' "$out"
}

url_of() {
  local file="$1" raw
  raw=$(sed -n 's|^Exec=omarchy-launch-browser[[:space:]]*\(--private[[:space:]]*\)\{0,1\}||p' "$file" | head -1)
  [[ -n $raw ]] || return 1
  exec_unquote "$(file_decode "$raw")"
}

icon_of() {
  sed -n 's/^Icon=//p' "$1" | head -1
}

# --------------------------------------------------------------- the entry
#
# Same keys omarchy-webapp-install writes, plus our markers. NoDisplay keeps the
# entry out of the app launcher: quicklinks appear there through their own menu
# rows (see menu_block), which carry an icon and read "Quicklinks" underneath
# rather than "Apps", and a second row for the same link would only be noise.
# The entry stays launchable by id (gtk-launch, the panel's `open`), so nothing
# depends on the rows.
entry_content() {
  local name="$1" url="$2" private="$3" icon="$4"
  cat <<DESKTOP
[Desktop Entry]
Version=1.0
Name=$name
GenericName=Quicklink
Comment=$name
Exec=$(exec_line_for "$url" "$private")
Terminal=false
Type=Application
Icon=$icon
NoDisplay=true
StartupNotify=true
$MARKER
DESKTOP
  ((private)) && printf '%s\n' "$PRIVATE_MARKER"
  return 0
}

# The symlink is what the launcher indexes. Relative targets would break when
# the plugin folder moves; absolute ones dangle cleanly when it is deleted.
ensure_link() {
  local name="$1" target link
  target=$(entry_file "$name")
  link=$(link_file "$name")
  [[ -L $link && $(readlink "$link") == "$target" ]] && return 0
  mkdir -p "$DESKTOP_DIR"
  ln -sfn "$target" "$link"
}

# Returns 0 when the entry or its link changed, 1 when both were already correct.
write_entry() {
  local name="$1" url="$2" private="$3" icon="$4" target content changed=1
  target=$(entry_file "$name")
  content=$(entry_content "$name" "$url" "$private" "$icon")
  if [[ ! -f $target || $(<"$target") != "$content" ]]; then
    mkdir -p "$ENTRY_DIR"
    printf '%s\n' "$content" >"$target"
    chmod +x "$target"
    changed=0
  fi
  [[ -L $(link_file "$name") && $(readlink "$(link_file "$name")") == "$target" ]] || changed=0
  ensure_link "$name"
  return $changed
}

remove_entry() { # <name>: entry, link and fetched icon
  local name="$1" safe
  safe=$(safe_icon_name "$name")
  rm -f "$(entry_file "$name")" "$(link_file "$name")"
  [[ -n $safe ]] && rm -f "$(icon_file "$safe")"
  return 0
}

# Menu rows mirror the entries, so every change to an entry regenerates them.
# Errors are swallowed: a menu file we refuse to edit must not break `add`.
refresh_menu() {
  cmd_menu_install >/dev/null 2>&1 || true
}

update_desktop_db() {
  update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
}

# The icon fetch talks to the network, so it never runs in the caller's path:
# the entry is written with a fallback icon first and this is started detached.
start_icon_fetch() {
  setsid "$SELF" fetch-icon "$1" "$2" >/dev/null 2>&1 &
}

# ------------------------------------------------------------- icon fetch
#
# Same chain as omarchy-webapp-install: the site's own apple-touch-icon link,
# then the well-known path, then Google's favicon service as a last resort.
download_icon() {
  curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null &&
    [[ -s $2 && $(file -b --mime-type "$2") == image/* ]]
}

fetch_site_icon() {
  local site_url="$1" dest="$2"
  local origin page icon_url
  origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")

  page=$(curl -fsSL --max-time 5 "$site_url" 2>/dev/null | head -c 100000 | tr '\n' ' ') || true
  icon_url=$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" |
    grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//") || true

  case $icon_url in
  http://* | https://*) ;;
  //*) icon_url="https:$icon_url" ;;
  /*) icon_url="$origin$icon_url" ;;
  ?*) icon_url="$origin/$icon_url" ;;
  esac

  { [[ -n $icon_url ]] && download_icon "$icon_url" "$dest"; } ||
    download_icon "$origin/apple-touch-icon.png" "$dest" ||
    download_icon "https://www.google.com/s2/favicons?domain=${site_url}&sz=256" "$dest"
}

# Runs detached from `add` and `edit`. Nothing here may fail loudly: a missing
# icon is cosmetic and the entry already works with the fallback. Icon= becomes
# the absolute path of the file, so no icon theme directory is ever touched.
cmd_fetch_icon() {
  local name="${1:-}" url="${2:-}" target safe tmp
  [[ -n $name && -n $url ]] || exit 0
  target=$(entry_file "$name")
  safe=$(safe_icon_name "$name")
  [[ -n $safe ]] || exit 0

  mkdir -p "$ICON_DIR"
  tmp=$(mktemp "$ICON_DIR/.$safe.XXXXXX")
  if fetch_site_icon "$url" "$tmp"; then
    mv -f "$tmp" "$(icon_file "$safe")"
    # The entry may have been removed or renamed while we were fetching.
    if is_quicklink "$target"; then
      sed -i "s|^Icon=.*|Icon=$(icon_file "$safe")|" "$target"
      update_desktop_db
    fi
  else
    rm -f "$tmp"
  fi
  exit 0
}

# ---------------------------------------------------------------- commands

each_entry() { # prints NUL-separated paths of every real quicklink entry
  [[ -d $ENTRY_DIR ]] || return 0
  find "$ENTRY_DIR" -maxdepth 1 -type f -name '*.desktop' -print0 2>/dev/null
}

# Tab-separated "name<TAB>url<TAB>icon<TAB>private", sorted by name.
# QuicklinksPanel.qml parses this.
cmd_list() {
  local file name url icon private
  while IFS= read -r -d '' file; do
    [[ -r $file ]] || continue
    is_quicklink "$file" || continue
    name=$(basename "${file%.desktop}")
    url=$(url_of "$file") || continue
    icon=$(icon_of "$file")
    private=false
    is_private "$file" && private=true
    printf '%s\t%s\t%s\t%s\n' "$name" "$url" "$icon" "$private"
  done < <(each_entry) | sort -f
}

cmd_info() {
  local name="${1:-}" target url private=false
  name=$(validate_name "$name")
  target=$(entry_file "$name")
  is_quicklink "$target" || die "no such quicklink: $name"
  url=$(url_of "$target") || die "could not read the URL for $name"
  is_private "$target" && private=true
  printf 'url\t%s\nicon\t%s\nprivate\t%s\n' "$url" "$(icon_of "$target")" "$private"
}

# Exits 0 when at least one quicklink exists. Cheap enough for a menu `when`
# guard, which runs every time the menu opens.
cmd_any() {
  grep -qsxF "$MARKER" "$ENTRY_DIR"/*.desktop 2>/dev/null
}

# A name is free when neither the real entry nor the launcher symlink exists.
refuse_taken() { # <name>
  local target link
  target=$(entry_file "$1")
  link=$(link_file "$1")
  if [[ -e $target ]]; then
    is_quicklink "$target" && die "a quicklink named \"$1\" already exists"
    die "\"$1\" already exists and is not a quicklink"
  fi
  if [[ -e $link || -L $link ]] && [[ $(readlink "$link" 2>/dev/null) != "$target" ]]; then
    die "$link already exists and is not ours"
  fi
}

# `add <name> <url> [--private] [--icon NAME]`; flags may appear anywhere.
cmd_add() {
  local name="" url="" icon="" private=0
  local positional=()
  while (($#)); do
    case $1 in
    --private) private=1 ;;
    --icon)
      shift
      icon="${1:-}"
      ;;
    *) positional+=("$1") ;;
    esac
    shift
  done
  name=$(validate_name "${positional[0]:-}")
  url=$(validate_url "${positional[1]:-}")
  refuse_taken "$name"

  write_entry "$name" "$url" "$private" "${icon:-$FALLBACK_ICON}" || true
  update_desktop_db
  refresh_menu
  [[ -n $icon ]] || start_icon_fetch "$name" "$url"
  echo "ok"
}

# `edit <name> [--name NEW] [--url URL] [--private|--no-private]`.
cmd_edit() {
  local name="${1:-}" new_name="" new_url="" private_flag="" target
  local url icon private=0 old_safe new_safe
  shift || true
  name=$(validate_name "$name")
  while (($#)); do
    case $1 in
    --name)
      shift
      new_name="${1:-}"
      ;;
    --url)
      shift
      new_url="${1:-}"
      ;;
    --private) private_flag=1 ;;
    --no-private) private_flag=0 ;;
    *) die "unknown option: $1" ;;
    esac
    shift
  done

  target=$(entry_file "$name")
  is_quicklink "$target" || die "no such quicklink: $name"
  url=$(url_of "$target") || die "could not read the URL for $name"
  icon=$(icon_of "$target")
  is_private "$target" && private=1
  [[ -n $private_flag ]] && private=$private_flag

  [[ -n $new_name ]] && new_name=$(validate_name "$new_name")
  [[ -n $new_url ]] && new_url=$(validate_url "$new_url")
  [[ -n $new_name && $new_name != "$name" ]] || new_name=""

  if [[ -n $new_name ]]; then
    refuse_taken "$new_name"
    old_safe=$(safe_icon_name "$name")
    new_safe=$(safe_icon_name "$new_name")
    # The icon file is named after the entry, so it follows the rename; the
    # Icon= value follows only when it pointed at that file.
    if [[ -n $old_safe && -n $new_safe && $old_safe != "$new_safe" && -f $(icon_file "$old_safe") ]]; then
      mv -f "$(icon_file "$old_safe")" "$(icon_file "$new_safe")"
      [[ $icon == "$(icon_file "$old_safe")" || $icon == "$old_safe" ]] && icon=$(icon_file "$new_safe")
    fi
    rm -f "$target" "$(link_file "$name")"
    name=$new_name
  fi

  write_entry "$name" "${new_url:-$url}" "$private" "$icon" || true
  update_desktop_db
  refresh_menu

  # A new host means the old icon is the wrong one.
  if [[ -n $new_url && $(url_host "$new_url") != "$(url_host "$url")" ]]; then
    start_icon_fetch "$name" "$new_url"
  fi
  echo "ok"
}

cmd_remove() {
  local name="${1:-}" target
  name=$(validate_name "$name")
  target=$(entry_file "$name")
  is_quicklink "$target" || die "no such quicklink: $name"
  remove_entry "$name"
  update_desktop_db
  refresh_menu
  echo "ok"
}

cmd_open() {
  local name="${1:-}" target url
  name=$(validate_name "$name")
  target=$(entry_file "$name")
  is_quicklink "$target" || die "no such quicklink: $name"
  url=$(url_of "$target") || die "could not read the URL for $name"
  if is_private "$target"; then
    setsid omarchy-launch-browser --private "$url" >/dev/null 2>&1 &
  else
    setsid omarchy-launch-browser "$url" >/dev/null 2>&1 &
  fi
  echo "ok"
}

# ------------------------------------------------------------- self-heal
#
# Older versions wrote the real entry straight into ~/.local/share/applications
# and the icon into ~/.local/share/icons/hicolor/256x256/apps. Move both into
# data/ and leave a symlink behind, so the launcher keeps finding the link and
# `omarchy plugin remove` now takes the data with it. Runs from `sync` on every
# panel open and does nothing once there is nothing left to migrate.
migrate_legacy() {
  local file name safe icon target changed=0
  [[ -d $DESKTOP_DIR ]] || return 1
  while IFS= read -r -d '' file; do
    is_quicklink "$file" || continue
    name=$(basename "${file%.desktop}")
    name=${name#"$LINK_PREFIX"}
    target=$(entry_file "$name")
    if [[ -e $target ]]; then
      # Both exist: the data copy wins, the stray regular file goes.
      rm -f "$file"
    else
      mkdir -p "$ENTRY_DIR"
      mv -f "$file" "$target"
    fi
    safe=$(safe_icon_name "$name")
    icon=$(icon_of "$target")
    if [[ -n $safe && -f $LEGACY_ICON_DIR/$safe.png ]]; then
      mkdir -p "$ICON_DIR"
      mv -f "$LEGACY_ICON_DIR/$safe.png" "$(icon_file "$safe")"
      [[ $icon == "$safe" ]] && sed -i "s|^Icon=.*|Icon=$(icon_file "$safe")|" "$target"
    elif [[ -n $safe && $icon == "$safe" ]]; then
      # Icon file is gone (or never landed); fall back rather than leave a
      # themed-icon name that resolves to nothing.
      sed -i "s|^Icon=.*|Icon=$FALLBACK_ICON|" "$target"
    fi
    ensure_link "$name"
    changed=1
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -type f -name '*.desktop' -print0 2>/dev/null)
  # Only what we may have created, only when empty.
  rmdir -p "$LEGACY_ICON_DIR" 2>/dev/null || true
  ((changed))
}

# Drop launcher symlinks of ours whose entry is gone (a previous plugin folder
# deleted by `omarchy plugin remove`, or an entry removed by hand). Returns 0
# when something was pruned.
prune_dangling_links() {
  local link target pruned=1
  [[ -d $DESKTOP_DIR ]] || return 1
  while IFS= read -r -d '' link; do
    target=$(readlink "$link") || continue
    # Ours by name, or by pointing into a plugin data folder of this id.
    [[ $(basename "$link") == "$LINK_PREFIX"* || $target == */"$PLUGIN_ID"/data/applications/* || $target == "$ENTRY_DIR"/* ]] || continue
    [[ -e $link ]] && continue
    rm -f "$link"
    pruned=0
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -type l -name '*.desktop' -print0 2>/dev/null)
  return $pruned
}

# Bring every entry up to the current format, make sure every entry has its
# launcher symlink, migrate legacy state, prune dangling symlinks and
# regenerate the menu rows. The panel runs this each time it opens; it touches
# nothing that is already correct.
cmd_sync() {
  local file name url icon private changed=0
  migrate_legacy && changed=1
  while IFS= read -r -d '' file; do
    [[ -r $file ]] && is_quicklink "$file" || continue
    name=$(basename "${file%.desktop}")
    url=$(url_of "$file") || continue
    icon=$(icon_of "$file")
    private=0
    is_private "$file" && private=1
    write_entry "$name" "$url" "$private" "${icon:-$FALLBACK_ICON}" && changed=1
  done < <(each_entry)
  prune_dangling_links && changed=1
  ((changed)) && update_desktop_db
  refresh_menu
  echo "ok"
}

# ------------------------------------------------------------- menu-driven
#
# A quicklink needs only a name and a URL, so the menu can collect both itself
# with omarchy-menu-input. That keeps this path free of any dependency on the
# panel or on custom IPC.
cmd_menu_new() {
  local name url
  name=$(omarchy-menu-input "Quicklink name") || exit 0
  name=$(printf '%s' "$name" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $name ]] || exit 0

  url=$(omarchy-menu-input "URL for \"$name\"") || exit 0
  url=$(printf '%s' "$url" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $url ]] || exit 0

  if cmd_add "$name" "$url" >/dev/null 2>&1; then
    omarchy-notification-send "Quicklink created" "$name" 2>/dev/null || true
  else
    omarchy-notification-send -u critical "Could not create quicklink" "$name" 2>/dev/null ||
      echo "Could not create quicklink: $name" >&2
  fi
}

# Pick a quicklink from the menu and delete it, mirroring omarchy-webapp-remove.
cmd_pick_remove() {
  local names=() sel answer
  mapfile -t names < <(cmd_list | cut -f1)

  if ((${#names[@]} == 0)); then
    omarchy-notification-send "No quicklinks to remove" 2>/dev/null || echo "No quicklinks to remove."
    exit 0
  fi

  sel=$(omarchy-menu-select "Select quicklink to remove" "${names[@]}" -- --width 520 --maxheight 520) || exit 0
  [[ -n $sel ]] || exit 0

  answer=$(omarchy-menu-select "Delete quicklink \"$sel\"?" "Delete" "Cancel") || exit 0
  [[ $answer == "Delete" ]] || exit 0

  cmd_remove "$sel" >/dev/null
  omarchy-notification-send "Quicklink removed" "$sel" 2>/dev/null || true
}

# `Remove > Quicklinks plugin` runs this in a floating terminal, the way the
# stock menu runs omarchy-webapp-remove and friends: confirm, then hand off.
cmd_menu_uninstall_plugin() {
  local n
  n=$(cmd_list | wc -l)
  if command -v gum >/dev/null 2>&1; then
    gum confirm "Remove the Quicklinks plugin and all $n quicklink(s)?" || exit 0
  else
    read -r -p "Remove the Quicklinks plugin and all $n quicklink(s)? [y/N] " answer
    [[ $answer == [yY]* ]] || exit 0
  fi
  cmd_uninstall --remove-plugin
}

# ---------------------------------------------------------------- menu rows
#
# The Omarchy menu is one JSONC file with no plugin API, so the plugin adds its
# own rows. Every row — the submenu, its children and each per-link row —
# carries the same `when` guard testing for this script, so the moment the
# plugin folder is gone every row stops appearing rather than erroring.

json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

# Single-quote a word for the shell command a menu row runs.
shell_squote() {
  local q="'\\''"
  printf "'%s'" "${1//\'/$q}"
}

GUARD="[ -x '$SELF' ]"

# One menu row per quicklink under the Quicklinks submenu. The row's action is
# the launch command itself, so opening a link never depends on this script
# running; the guard ties the row's existence to the plugin. Row ids are slugs
# of the name, made unique so two names that slug alike both survive.
menu_link_rows() {
  local -A used=()
  local name url icon private slug id n glyph flag
  while IFS=$'\t' read -r name url icon private; do
    [[ -n $name ]] || continue
    slug=$(safe_icon_name "$name")
    [[ -n $slug ]] || slug=link
    id=$slug
    n=2
    while [[ -n ${used[$id]+x} ]]; do id="$slug-$n"; n=$((n + 1)); done
    used[$id]=1
    glyph="󰌷"
    flag=""
    if [[ $private == true ]]; then
      glyph="󰒃"
      flag="--private "
    fi
    printf '  "quicklinks.%s": {"icon":"%s","label":"%s","description":"%s","when":"%s","action":"omarchy-launch-browser %s%s"},\n' \
      "$id" "$glyph" "$(json_escape "$name")" "$(json_escape "$url")" \
      "$(json_escape "$GUARD")" \
      "$flag" "$(json_escape "$(shell_squote "$url")")"
  done < <(cmd_list)
}

# "quicklinks" is a submenu: searching the menu for a link's name finds its row
# with the link glyph and "Quicklinks" underneath, where a desktop entry would
# have shown "Apps". The panel is reachable from the submenu's first row.
menu_block() {
  local g self
  g=$(json_escape "$GUARD")
  self=$(json_escape "$(shell_squote "$SELF")")
  cat <<JSONC
  // >>> omarchy-quicklinks (added by: quicklinks menu-install)
  "quicklinks": {"icon":"󰌷","label":"Quicklinks","aliases":["quicklink","links","bookmarks"],"description":"Saved links that open in your default browser","when":"$g"},
  "quicklinks.manage": {"icon":"󰒓","label":"Manage quicklinks","description":"Search, add, edit and remove links","when":"$g","action":"omarchy-shell $PLUGIN_ID toggle"},
$(menu_link_rows)
  "install.quicklink": {"icon":"󰉉","label":"Quicklink","description":"A named URL that opens in your default browser","when":"$g","action":"$self menu-new"},
  "remove.quicklink": {"icon":"󰭌","label":"Quicklink","when":"$g && $self any","action":"$self pick-remove"},
  "remove.quicklinks-plugin": {"icon":"󰌷","label":"Quicklinks plugin","description":"Remove the plugin and every quicklink","when":"$g","action":"omarchy-launch-floating-terminal-with-presentation $self menu-uninstall-plugin"},
  // <<< omarchy-quicklinks
JSONC
}

menu_current_block() {
  local file="$1"
  [[ -f $file ]] || return 0
  awk '
    index($0, "// >>> omarchy-quicklinks") { inside = 1 }
    inside { print }
    inside && index($0, "// <<< omarchy-quicklinks") { inside = 0 }
  ' "$file"
}

# Keep exactly one backup, overwritten in place.
menu_backup() {
  cp "$1" "$1.bak"
}

# Versions before this wrote "<file>.bak.<epoch>" on every change and never
# cleaned them up. Sweep any away whenever we run, not only when we write, so
# an existing pile clears itself on the next shell start. Omarchy writes no
# .bak files next to this one, so the pattern is unambiguously ours.
menu_prune_legacy_backups() {
  local file="$1" legacy
  for legacy in "$file".bak.[0-9]*; do
    [[ -e $legacy ]] && rm -f "$legacy"
  done
  return 0
}

menu_strip() {
  local file="$1" tmp
  [[ -f $file ]] || return 0
  tmp=$(mktemp)
  awk '
    index($0, "// >>> omarchy-quicklinks") { skip = 1; next }
    skip && index($0, "// <<< omarchy-quicklinks") { skip = 0; next }
    !skip
  ' "$file" >"$tmp" && mv "$tmp" "$file"
}

cmd_menu_install() {
  local file="$MENU_EXTENSION" tmp out
  mkdir -p "$(dirname "$file")"
  [[ -f $file ]] || printf '{\n}\n' >"$file"

  menu_prune_legacy_backups "$file"

  # Already correct: touch nothing, so this is safe on every shell start.
  if [[ $(menu_current_block "$file") == "$(menu_block)" ]]; then
    echo "ok"
    return 0
  fi

  grep -qE '^[[:space:]]*\}[[:space:]]*$' "$file" ||
    die "$file has no closing brace on a line of its own; refusing to edit it"

  menu_backup "$file"
  menu_strip "$file"

  tmp=$(mktemp)
  menu_block >"$tmp"
  out=$(mktemp)
  awk '
    NR == FNR { block[FNR] = $0; nb = FNR; next }
    { lines[FNR] = $0; nl = FNR }
    END {
      last = 0
      for (i = 1; i <= nl; i++) if (lines[i] ~ /^[[:space:]]*\}[[:space:]]*$/) last = i
      for (i = 1; i <= nl; i++) {
        if (i == last) for (j = 1; j <= nb; j++) print block[j]
        print lines[i]
      }
    }
  ' "$tmp" "$file" >"$out" && mv "$out" "$file"
  rm -f "$tmp"

  command -v omarchy >/dev/null 2>&1 && omarchy menu refresh >/dev/null 2>&1 || true
  echo "ok"
}

cmd_menu_uninstall() {
  [[ -f $MENU_EXTENSION ]] || { echo "ok"; return 0; }
  menu_backup "$MENU_EXTENSION"
  menu_strip "$MENU_EXTENSION"
  menu_remove_if_ours "$MENU_EXTENSION"
  command -v omarchy >/dev/null 2>&1 && omarchy menu refresh >/dev/null 2>&1 || true
  echo "ok"
}

# menu-install creates the extension file as a bare "{\n}" when it does not
# exist. If that is all that is left once our rows are gone, the file is ours
# and goes too, along with the extensions directory when we emptied it.
menu_remove_if_ours() {
  local file="$1"
  [[ -f $file ]] || return 0
  [[ $(<"$file") == $'{\n}' ]] || return 0
  rm -f "$file"
  menu_remove_backup_if_ours "$file"
  rmdir "$(dirname "$file")" 2>/dev/null || true
}

# The .bak next to the extension file is ours when it holds our rows (restoring
# it would bring them back) or when it is the bare skeleton menu-install wrote.
# Anything else is left alone: another tool may have written it.
menu_remove_backup_if_ours() {
  local bak="$1.bak"
  [[ -f $bak ]] || return 0
  if grep -q '// >>> omarchy-quicklinks' "$bak" || [[ $(<"$bak") == $'{\n}' ]]; then
    rm -f "$bak"
  fi
}

# ------------------------------------------------------------ export / import
#
# A portable snapshot of every quicklink, so a list can be moved to another
# machine or kept before removing the plugin. `icon` is only recorded when it
# is a themed icon the user chose (add --icon); the fallback and any icon this
# plugin fetched from the site are left out, since import fetches them afresh.
EXPORT_FORMAT="omarchy-quicklinks"
EXPORT_VERSION=1

default_export_path() {
  local dir
  dir=$(xdg-user-dir DOWNLOAD 2>/dev/null) || dir=""
  [[ -n $dir && -d $dir ]] || dir="$HOME/Downloads"
  [[ -d $dir ]] || dir="$HOME"
  printf '%s/omarchy-quicklinks-%s.json\n' "$dir" "$(date +%Y-%m-%d)"
}

export_json() {
  local name url icon private
  cmd_list | while IFS=$'\t' read -r name url icon private; do
    [[ -n $name ]] || continue
    { [[ $icon == "$FALLBACK_ICON" ]] || is_fetched_icon "$icon" "$name"; } && icon=""
    jq -cn --arg name "$name" --arg url "$url" --arg icon "$icon" --argjson private "$private" \
      '{name: $name, url: $url, private: $private} + (if $icon == "" then {} else {icon: $icon} end)'
  done | jq -s --arg format "$EXPORT_FORMAT" --argjson version "$EXPORT_VERSION" \
    --arg exported "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{format: $format, version: $version, exported: $exported, quicklinks: .}'
}

# `export [FILE]`. FILE defaults to ~/Downloads/omarchy-quicklinks-<date>.json;
# `-` writes to stdout. An existing FILE is refused unless --force is given.
# Prints the path written.
cmd_export() {
  local file="" force=0 tmp
  while (($#)); do
    case $1 in
    --force) force=1 ;;
    -) file="-" ;;
    -*) die "unknown option: $1" ;;
    *) file="$1" ;;
    esac
    shift
  done
  command -v jq >/dev/null 2>&1 || die "export needs jq"
  if [[ $file == "-" ]]; then
    export_json
    return 0
  fi
  [[ -n $file ]] || file=$(default_export_path)
  [[ -d $file ]] && file="$file/$(basename "$(default_export_path)")"
  [[ -e $file && $force == 0 ]] && die "$file already exists; pass --force to overwrite"
  mkdir -p "$(dirname "$file")"
  tmp=$(mktemp "$(dirname "$file")/.quicklinks-export.XXXXXX")
  if export_json >"$tmp"; then
    mv -f "$tmp" "$file"
  else
    rm -f "$tmp"
    die "could not write $file"
  fi
  printf '%s\n' "$file"
}

# `import FILE [--replace]`. Reads a file written by export (or a bare JSON
# array of {name, url, private?, icon?}). Names that already exist are skipped
# unless --replace, which overwrites them. Prints "imported N skipped M".
cmd_import() {
  local file="" replace=0 name url private icon imported=0 skipped=0 target
  while (($#)); do
    case $1 in
    --replace) replace=1 ;;
    -) file="-" ;;
    -*) die "unknown option: $1" ;;
    *) file="$1" ;;
    esac
    shift
  done
  [[ -n $file ]] || die "usage: quicklinks import <file> [--replace]"
  command -v jq >/dev/null 2>&1 || die "import needs jq"
  [[ $file == "-" ]] && file=/dev/stdin
  [[ -r $file ]] || die "cannot read $file"

  local rows
  rows=$(jq -r '
    (if type == "array" then . else (.quicklinks // empty) end)
    | .[]
    | select(type == "object" and (.name | type) == "string" and (.url | type) == "string")
    | [.name, .url, ((.private // false) | tostring), (.icon // "")]
    | @tsv
  ' "$file" 2>/dev/null) || die "$file is not a quicklinks export"

  while IFS=$'\t' read -r name url private icon; do
    [[ -n $name ]] || continue
    # @tsv escapes tabs and backslashes; undo that.
    name=$(printf '%b' "$name")
    url=$(printf '%b' "$url")
    icon=$(printf '%b' "$icon")
    name=$(validate_name "$name" 2>/dev/null) || { skipped=$((skipped + 1)); continue; }
    target=$(entry_file "$name")
    if [[ -e $target ]]; then
      if ((replace)) && is_quicklink "$target"; then
        cmd_remove "$name" >/dev/null
      else
        skipped=$((skipped + 1))
        continue
      fi
    fi
    local args=("$name" "$url")
    [[ $private == true ]] && args+=(--private)
    [[ -n $icon ]] && args+=(--icon "$icon")
    if cmd_add "${args[@]}" >/dev/null 2>&1; then
      imported=$((imported + 1))
    else
      skipped=$((skipped + 1))
    fi
  done <<<"$rows"
  printf 'imported %d skipped %d\n' "$imported" "$skipped"
}

# ------------------------------------------------------------------ uninstall
#
# Omarchy runs no plugin hooks on `omarchy plugin remove`: it disables the
# plugin, deletes the folder and rescans. Everything this plugin ever writes
# outside its own folder is listed here so one command can take it all back:
#
#   - the launcher symlinks in ~/.local/share/applications
#   - its rows in ~/.config/omarchy/extensions/omarchy-menu.jsonc, the "{\n}"
#     file it created when none existed, and the .bak it wrote next to it
#   - anything a pre-1.4 version left in the legacy locations (migrated first)
#
# and, inside the folder, data/ with every entry and icon — unless
# `--keep-quicklinks`, which leaves data/ and the symlinks so they stay
# launchable until the plugin folder itself is removed. `--remove-plugin`
# finishes by handing off to `omarchy plugin remove`, which removes the plugin
# folder and its shell.json entry. Nothing that this plugin did not create is
# touched, and directories are removed only when they are empty.
cmd_uninstall() {
  local keep=0 remove_plugin=0 file name removed=0
  while (($#)); do
    case $1 in
    --keep-quicklinks) keep=1 ;;
    --remove-plugin) remove_plugin=1 ;;
    --yes | -y) ;;
    *) die "unknown option: $1" ;;
    esac
    shift
  done

  migrate_legacy || true
  prune_dangling_links || true

  if ((!keep)); then
    while IFS= read -r -d '' file; do
      is_quicklink "$file" || continue
      name=$(basename "${file%.desktop}")
      rm -f "$(link_file "$name")"
      removed=$((removed + 1))
    done < <(each_entry)
    rm -rf "$DATA_DIR"
    rmdir "$DESKTOP_DIR" 2>/dev/null || true
  fi
  update_desktop_db

  if [[ -f $MENU_EXTENSION ]]; then
    menu_prune_legacy_backups "$MENU_EXTENSION"
    menu_strip "$MENU_EXTENSION"
    menu_remove_backup_if_ours "$MENU_EXTENSION"
    menu_remove_if_ours "$MENU_EXTENSION"
    command -v omarchy >/dev/null 2>&1 && omarchy menu refresh >/dev/null 2>&1 || true
  fi

  if ((keep)); then
    echo "removed menu rows and backups; quicklinks kept"
  else
    echo "removed $removed quicklink(s), menu rows and backups"
  fi

  if ((remove_plugin)); then
    command -v omarchy >/dev/null 2>&1 || die "omarchy is not on PATH; remove the plugin folder by hand"
    exec omarchy plugin remove "$PLUGIN_ID" --yes
  fi
}

case "${1:-list}" in
list) cmd_list ;;
any) cmd_any ;;
add)
  shift
  cmd_add "$@"
  ;;
edit)
  shift
  cmd_edit "$@"
  ;;
info)
  shift
  cmd_info "$@"
  ;;
remove)
  shift
  cmd_remove "$@"
  ;;
open)
  shift
  cmd_open "$@"
  ;;
fetch-icon)
  shift
  cmd_fetch_icon "$@"
  ;;
sync) cmd_sync ;;
menu-new) cmd_menu_new ;;
pick-remove) cmd_pick_remove ;;
menu-uninstall-plugin) cmd_menu_uninstall_plugin ;;
menu-install) cmd_menu_install ;;
menu-uninstall) cmd_menu_uninstall ;;
export)
  shift
  cmd_export "$@"
  ;;
import)
  shift
  cmd_import "$@"
  ;;
uninstall)
  shift
  cmd_uninstall "$@"
  ;;
*) die "usage: quicklinks <list|any|add|edit|info|remove|open|sync|fetch-icon|export|import|menu-new|pick-remove|menu-install|menu-uninstall|uninstall> [args]" ;;
esac

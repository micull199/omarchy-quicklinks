#!/bin/bash

# Backend for the Quicklinks Omarchy shell plugin.
#
# Lives inside the plugin folder and is invoked by Panel.qml with an absolute
# path, so it is installed and removed with the plugin and never touches PATH.
#
# A quicklink is a desktop entry carrying X-Omarchy-Quicklink=true. The Exec
# line calls omarchy-launch-browser, an Omarchy built-in, rather than anything
# owned by this plugin — so removing the plugin leaves working launcher entries
# behind instead of dangling ones.

set -euo pipefail

DESKTOP_DIR="$HOME/.local/share/applications"
MENU_EXTENSION="${OMARCHY_MENU_EXTENSION:-$HOME/.config/omarchy/extensions/omarchy-menu.jsonc}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
MARKER="X-Omarchy-Quicklink=true"
FALLBACK_ICON="web-browser"

die() {
  echo "$*" >&2
  exit 1
}

is_quicklink() {
  [[ -f $1 ]] && grep -qxF "$MARKER" "$1" 2>/dev/null
}

desktop_file() { printf '%s\n' "$DESKTOP_DIR/$1.desktop"; }

safe_icon_name() {
  printf '%s\n' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

escape_exec() {
  local url="$1"
  url=${url//\\/\\\\}
  url=${url//\"/\\\"}
  url=${url//%/%%}
  printf '"%s"' "$url"
}

unescape_exec() {
  local url="$1"
  [[ $url == \"*\" ]] && url=${url:1:${#url}-2}
  url=${url//%%/%}
  url=${url//\\\"/\"}
  url=${url//\\\\/\\}
  printf '%s\n' "$url"
}

normalize_url() {
  local url="$1"
  [[ -n $url ]] || return 1
  [[ $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || url="https://$url"
  printf '%s\n' "$url"
}

url_of() {
  local file="$1" raw
  raw=$(sed -n 's|^Exec=omarchy-launch-browser[[:space:]]*||p' "$file" | head -1)
  [[ -n $raw ]] || return 1
  unescape_exec "$raw"
}

icon_of() {
  sed -n 's/^Icon=//p' "$1" | head -1
}

# Tab-separated "name<TAB>url<TAB>icon", sorted by name. Panel.qml parses this.
cmd_list() {
  [[ -d $DESKTOP_DIR ]] || return 0
  local file name url icon
  while IFS= read -r -d '' file; do
    is_quicklink "$file" || continue
    name=$(basename "${file%.desktop}")
    url=$(url_of "$file") || continue
    icon=$(icon_of "$file")
    printf '%s\t%s\t%s\n' "$name" "$url" "$icon"
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -type f -name '*.desktop' -print0 2>/dev/null) | sort -f
}

cmd_add() {
  local name="${1:-}" url="${2:-}" icon="${3:-}" target exec_cmd

  [[ -n $name ]] || die "a name is required"
  [[ $name != */* ]] || die "a name cannot contain \"/\""
  [[ $name != .* ]] || die "a name cannot start with a dot"
  url=$(normalize_url "$url") || die "a URL is required"

  target=$(desktop_file "$name")
  if [[ -e $target ]] && ! is_quicklink "$target"; then
    die "\"$name\" already exists and is not a quicklink"
  fi

  exec_cmd="omarchy-launch-browser $(escape_exec "$url")"

  # Delegate to Omarchy's own installer for icon fetching and the .desktop
  # format; argument 4 overrides the Exec line, an empty argument 3 triggers
  # the icon auto-fetch chain.
  if ! omarchy-webapp-install "$name" "$url" "$icon" "$exec_cmd" >/dev/null 2>&1; then
    omarchy-webapp-install "$name" "$url" "$FALLBACK_ICON" "$exec_cmd" >/dev/null ||
      die "could not create \"$name\""
  fi

  grep -qxF "$MARKER" "$target" 2>/dev/null || printf '%s\n' "$MARKER" >>"$target"
  update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
  echo "ok"
}

cmd_remove() {
  local name="${1:-}" target icon
  [[ -n $name ]] || die "a name is required"
  target=$(desktop_file "$name")
  is_quicklink "$target" || die "no such quicklink: $name"

  icon=$(safe_icon_name "$name")
  rm -f "$target" "$ICON_DIR/$icon.png" "$ICON_DIR/$name.png"
  update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
  echo "ok"
}

cmd_open() {
  local name="${1:-}" target url
  [[ -n $name ]] || die "a name is required"
  target=$(desktop_file "$name")
  is_quicklink "$target" || die "no such quicklink: $name"
  url=$(url_of "$target") || die "could not read the URL for $name"
  setsid omarchy-launch-browser "$url" >/dev/null 2>&1 &
  echo "ok"
}

# ------------------------------------------------------------- menu-driven
#
# A quicklink needs only a name and a URL, so the menu can collect both itself
# with omarchy-menu-input. That keeps this path free of any dependency on the
# panel or on custom IPC, which the reload burst during `omarchy plugin add`
# can leave unregistered.
cmd_menu_new() {
  local name url
  name=$(omarchy-menu-input "Quicklink name") || exit 0
  name=$(printf '%s' "$name" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $name ]] || exit 0

  url=$(omarchy-menu-input "URL for \"$name\"") || exit 0
  url=$(printf '%s' "$url" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $url ]] || exit 0

  if cmd_add "$name" "$url" >/dev/null 2>&1; then
    omarchy-notification-send "Quicklink created" "$name" 2>/dev/null || true
  else
    omarchy-notification-send -u critical "Could not create quicklink" "$name" 2>/dev/null ||
      echo "Could not create quicklink: $name" >&2
  fi
}

# Pick a quicklink from the menu and delete it, mirroring omarchy-webapp-remove.
cmd_pick_remove() {
  local names=() name sel answer
  mapfile -t names < <(cmd_list | cut -f1)

  if ((${#names[@]} == 0)); then
    omarchy-notification-send "No quicklinks to remove" 2>/dev/null || echo "No quicklinks to remove."
    exit 0
  fi

  sel=$(omarchy-menu-select "Select quicklink to remove" "${names[@]}" -- --width 520 --maxheight 520) || exit 0
  [[ -n $sel ]] || exit 0

  answer=$(omarchy-menu-select "Delete quicklink \"$sel\"?" "Delete" "Cancel") || exit 0
  [[ $answer == "Delete" ]] || exit 0

  cmd_remove "$sel" >/dev/null
  omarchy-notification-send "Quicklink removed" "$sel" 2>/dev/null || true
}

# ---------------------------------------------------------------- menu rows
#
# The Omarchy menu is one JSONC file with no plugin API, so the plugin adds its
# own rows. Every row carries a `when` guard testing for this script, so if the
# plugin goes away the rows stop appearing rather than erroring.

menu_block() {
  cat <<JSONC
  // >>> omarchy-quicklinks (added by: quicklinks menu-install)
  "quicklinks": {"icon":"","label":"Quicklinks","aliases":["quicklink","links","bookmarks"],"description":"Open a saved link in the default browser","when":"[ -x '$SELF' ] && grep -qsl 'X-Omarchy-Quicklink=true' \$HOME/.local/share/applications/*.desktop","action":"omarchy-shell micull199.quicklinks toggle"},
  "install.quicklink": {"icon":"󰉉","label":"Quicklink","description":"A named URL that opens in your default browser","when":"[ -x '$SELF' ]","action":"'$SELF' menu-new"},
  "remove.quicklink": {"icon":"󰭌","label":"Quicklink","when":"[ -x '$SELF' ] && grep -qsl 'X-Omarchy-Quicklink=true' \$HOME/.local/share/applications/*.desktop","action":"'$SELF' pick-remove"},
  // <<< omarchy-quicklinks
JSONC
}

menu_current_block() {
  local file="$1"
  [[ -f $file ]] || return 0
  awk '
    index($0, "// >>> omarchy-quicklinks") { inside = 1 }
    inside { print }
    inside && index($0, "// <<< omarchy-quicklinks") { inside = 0 }
  ' "$file"
}

# Keep exactly one backup, overwritten in place. Versions before this wrote
# "<file>.bak.<epoch>" on every change and never cleaned them up, so sweep any
# of those away too. Omarchy itself writes no .bak files next to this one, so
# the pattern is unambiguously ours.
menu_backup() {
  cp "$1" "$1.bak"
}

# Versions before this wrote "<file>.bak.<epoch>" on every change and never
# cleaned them up. Sweep any away whenever we run, not only when we write, so
# an existing pile clears itself on the next shell start. Omarchy writes no
# .bak files next to this one, so the pattern is unambiguously ours.
menu_prune_legacy_backups() {
  local file="$1" legacy
  for legacy in "$file".bak.[0-9]*; do
    [[ -e $legacy ]] && rm -f "$legacy"
  done
  return 0
}

menu_strip() {
  local file="$1" tmp
  [[ -f $file ]] || return 0
  tmp=$(mktemp)
  awk '
    index($0, "// >>> omarchy-quicklinks") { skip = 1; next }
    skip && index($0, "// <<< omarchy-quicklinks") { skip = 0; next }
    !skip
  ' "$file" >"$tmp" && mv "$tmp" "$file"
}

cmd_menu_install() {
  local file="$MENU_EXTENSION" tmp out
  mkdir -p "$(dirname "$file")"
  [[ -f $file ]] || printf '{\n}\n' >"$file"

  menu_prune_legacy_backups "$file"

  # Already correct: touch nothing, so this is safe on every shell start.
  if [[ $(menu_current_block "$file") == "$(menu_block)" ]]; then
    echo "ok"
    return 0
  fi

  grep -qE '^[[:space:]]*\}[[:space:]]*$' "$file" ||
    die "$file has no closing brace on a line of its own; refusing to edit it"

  menu_backup "$file"
  menu_strip "$file"

  tmp=$(mktemp)
  menu_block >"$tmp"
  out=$(mktemp)
  awk '
    NR == FNR { block[FNR] = $0; nb = FNR; next }
    { lines[FNR] = $0; nl = FNR }
    END {
      last = 0
      for (i = 1; i <= nl; i++) if (lines[i] ~ /^[[:space:]]*\}[[:space:]]*$/) last = i
      for (i = 1; i <= nl; i++) {
        if (i == last) for (j = 1; j <= nb; j++) print block[j]
        print lines[i]
      }
    }
  ' "$tmp" "$file" >"$out" && mv "$out" "$file"
  rm -f "$tmp"

  command -v omarchy >/dev/null 2>&1 && omarchy menu refresh >/dev/null 2>&1 || true
  echo "ok"
}

cmd_menu_uninstall() {
  [[ -f $MENU_EXTENSION ]] || { echo "ok"; return 0; }
  menu_backup "$MENU_EXTENSION"
  menu_strip "$MENU_EXTENSION"
  command -v omarchy >/dev/null 2>&1 && omarchy menu refresh >/dev/null 2>&1 || true
  echo "ok"
}

case "${1:-list}" in
list) cmd_list ;;
add)
  shift
  cmd_add "$@"
  ;;
remove)
  shift
  cmd_remove "$@"
  ;;
open)
  shift
  cmd_open "$@"
  ;;
menu-new) cmd_menu_new ;;
pick-remove) cmd_pick_remove ;;
menu-install) cmd_menu_install ;;
menu-uninstall) cmd_menu_uninstall ;;
*) die "usage: quicklinks <list|add|remove|open|menu-new|pick-remove|menu-install|menu-uninstall> [args]" ;;
esac

assert_eq "menu-new normalized the url" "https://made.example" "$(L info "Menu Made" | head -1 | cut -f2)"
assert_contains "menu-new notifies" "Quicklink created" "$(cat "$T/notify.log")"
rm -f "$T/input.n"
stub omarchy-menu-input 'exit 1'
assert_ok "menu-new cancelled exits 0" L menu-new
L remove "Menu Made" >/dev/null


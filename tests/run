#!/bin/bash

# Test suite for bin/quicklinks. Plain bash, no framework.
#
# Everything runs against a throwaway scratch tree: the desktop entry, icon and
# menu extension paths are all overridden, HOME points into the scratch so the
# real ~/.local/share is never touched, and the tools the script shells out to
# (update-desktop-database, curl, omarchy-launch-browser, ...) are stubbed on
# PATH so nothing is fetched or launched for real.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
Q="$ROOT/bin/quicklinks"

SCRATCH_BASE="${SCRATCH_BASE:-${TMPDIR:-/tmp}}"
mkdir -p "$SCRATCH_BASE"
T=$(mktemp -d "$SCRATCH_BASE/quicklinks-test.XXXXXX")
trap 'rm -rf "$T"' EXIT

export HOME="$T/home"
export OMARCHY_QUICKLINKS_DESKTOP_DIR="$T/desktop"
export OMARCHY_QUICKLINKS_ICON_DIR="$T/icons"
export OMARCHY_MENU_EXTENSION="$T/ext/omarchy-menu.jsonc"
export BROWSER_LOG="$T/browser.log"
mkdir -p "$HOME" "$T/bin"

# ---------------------------------------------------------------- stubs
stub() { printf '#!/bin/bash\n%s\n' "$2" >"$T/bin/$1"; chmod +x "$T/bin/$1"; }
stub update-desktop-database 'echo "$@" >>"'"$T"'/udd.log"'
stub gtk-update-icon-cache 'echo "$@" >>"'"$T"'/gtk.log"'
stub curl 'echo "$@" >>"'"$T"'/curl.log"; exit 22'
stub file 'echo image/png'
stub omarchy 'exit 0'
stub omarchy-launch-browser 'printf "%s\n" "$@" >>"$BROWSER_LOG"'
stub setsid 'exec "$@"'
stub omarchy-menu-input 'exit 1'
stub omarchy-menu-select 'exit 1'
stub omarchy-notification-send 'exit 0'
stub xdg-user-dir 'echo "$HOME/Downloads"'
export PATH="$T/bin:$PATH"

# ---------------------------------------------------------------- harness
pass=0
fail=0
ok() { pass=$((pass + 1)); }
ko() { fail=$((fail + 1)); echo "FAIL: $*" >&2; }

assert_eq() { # assert_eq <label> <expected> <actual>
  if [[ $2 == "$3" ]]; then ok; else ko "$1"$'\n  expected: '"$(printf '%q' "$2")"$'\n    actual: '"$(printf '%q' "$3")"; fi
}
assert_ok() { # assert_ok <label> <cmd...>
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then ok; else ko "$label (expected exit 0)"; fi
}
assert_fails() { # assert_fails <label> <cmd...>
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then ko "$label (expected non-zero exit)"; else ok; fi
}
assert_file() { [[ -f $2 ]] && ok || ko "$1: missing file $2"; }
assert_no_file() { [[ ! -e $2 ]] && ok || ko "$1: unexpected file $2"; }
assert_contains() { [[ $3 == *"$2"* ]] && ok || ko "$1"$'\n  wanted: '"$2"$'\n      in: '"$3"; }
assert_not_contains() { [[ $3 != *"$2"* ]] && ok || ko "$1"$'\n  did not want: '"$2"$'\n            in: '"$3"; }

L() { "$Q" "$@"; }
MARKER_LINE="X-Omarchy-Quicklink=true"
entry() { printf '%s\n' "$OMARCHY_QUICKLINKS_DESKTOP_DIR/$1.desktop"; }
icon() { printf '%s\n' "$OMARCHY_QUICKLINKS_ICON_DIR/$1.png"; }
exec_of() { grep '^Exec=' "$(entry "$1")" | cut -d= -f2-; }
# Wait for the detached fetch-icon started by add/edit; curl is stubbed to fail
# instantly so this only has to outlast process startup.
settle() { sleep 0.3; }

# GLib is the parser gtk-launch and GNOME use. get_commandline() returns the
# Exec value after the string-layer decode only; launching then expands %% and
# runs g_shell_parse_argv on it, so do the same and check the argv the browser
# would receive.
glib_argv() {
  python3 - "$1" 2>/dev/null <<'PY'
import sys, re, gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib
a = Gio.DesktopAppInfo.new_from_filename(sys.argv[1])
if a is None:
    print("REJECTED"); sys.exit(0)
cmd = re.sub(r"%(.)", lambda m: "%" if m.group(1) == "%" else "", a.get_commandline())
print("\n".join(GLib.shell_parse_argv(cmd)[1]))
PY
}
HAVE_GI=0; python3 -c 'import gi' 2>/dev/null && HAVE_GI=1
assert_glib_cmdline() { # <label> <name> <url> [--private]
  local want="omarchy-launch-browser"
  [[ ${4:-} == --private ]] && want+=$'\n--private'
  ((HAVE_GI)) && assert_eq "$1" "$want"$'\n'"$3" "$(glib_argv "$(entry "$2")")"
}
assert_valid() { assert_ok "$1" desktop-file-validate "$(entry "$2")"; }

# Add a URL and check it survives every layer: file, list, info, validator, GLib.
roundtrip() { # <label> <name> <url>
  assert_eq "$1: add ok" "ok" "$(L add "$2" "$3")"
  assert_eq "$1: info url" "$3" "$(L info "$2" | grep -P '^url\t' | cut -f2-)"
  assert_eq "$1: list url" "$3" "$(L list | grep -P "^\Q$2\E\t" | cut -f2)"
  assert_valid "$1: desktop-file-validate" "$2"
  assert_glib_cmdline "$1: GLib commandline" "$2" "$3"
}

# ================================================================ add / list / info
echo "# add/list/info roundtrip"
start=$(date +%s%N)
assert_eq "add prints ok" "ok" "$(L add Invoices https://books.example.com/invoices)"
elapsed=$(( ($(date +%s%N) - start) / 1000000 ))
(( elapsed < 1000 )) && ok || ko "add took ${elapsed}ms; expected well under a second"
assert_file "entry written" "$(entry Invoices)"
assert_eq "fallback icon written immediately" "Icon=web-browser" "$(grep '^Icon=' "$(entry Invoices)")"
assert_eq "list row" $'Invoices\thttps://books.example.com/invoices\tweb-browser\tfalse' "$(L list)"
assert_eq "info rows" $'url\thttps://books.example.com/invoices\nicon\tweb-browser\nprivate\tfalse' "$(L info Invoices)"
assert_eq "Exec shape" 'omarchy-launch-browser "https://books.example.com/invoices"' "$(exec_of Invoices)"
assert_contains "marker present" $'\nX-Omarchy-Quicklink=true' "$(cat "$(entry Invoices)")"
assert_not_contains "no private marker" "Private" "$(cat "$(entry Invoices)")"
assert_valid "desktop-file-validate plain" Invoices
assert_glib_cmdline "GLib plain" Invoices https://books.example.com/invoices
settle
assert_contains "icon fetch attempted in background" "apple-touch-icon" "$(cat "$T/curl.log")"
assert_eq "failed fetch keeps fallback icon" "Icon=web-browser" "$(grep '^Icon=' "$(entry Invoices)")"
assert_eq "failed fetch leaves no icon file" "" "$(ls -A "$OMARCHY_QUICKLINKS_ICON_DIR" 2>/dev/null)"
assert_fails "info missing" L info Nope
assert_eq "add --icon skips fetch" "ok" "$(L add Iconed https://iconed.example.com --icon my-icon)"
assert_eq "add --icon sets Icon=" "Icon=my-icon" "$(grep '^Icon=' "$(entry Iconed)")"
: >"$T/curl.log"; settle
assert_eq "add --icon made no fetch" "" "$(cat "$T/curl.log")"

# ================================================================ name validation
echo "# name validation"
assert_fails "empty name" L add "" https://x.example
assert_fails "whitespace-only name" L add "   " https://x.example
assert_fails "tab in name" L add $'a\tb' https://x.example
assert_fails "newline in name" L add $'a\nb' https://x.example
assert_fails "slash in name" L add "a/b" https://x.example
assert_fails "leading dot" L add ".hidden" https://x.example
assert_eq "slash error to stderr" 'a name cannot contain "/"' "$(L add "a/b" https://x.example 2>&1 >/dev/null)"
assert_eq "trimmed name saves" "ok" "$(L add "  Trimmed  " https://t.example)"
assert_file "trimmed entry" "$(entry Trimmed)"
assert_no_file "untrimmed entry absent" "$(entry "  Trimmed  ")"
assert_eq "trimmed Name=" "Name=Trimmed" "$(grep '^Name=' "$(entry Trimmed)")"
assert_eq "info accepts untrimmed name" $'url\thttps://t.example' "$(L info "  Trimmed " | head -1)"

# ================================================================ url validation
echo "# url validation"
assert_fails "empty url" L add NoUrl ""
assert_fails "missing url" L add NoUrl
assert_fails "tab in url" L add BadUrl $'https://a.example/\tb'
assert_fails "newline in url" L add BadUrl $'https://a.example/\nb'
assert_no_file "rejected add wrote nothing" "$(entry BadUrl)"
assert_eq "scheme defaulted" "ok" "$(L add Bare example.com/path)"
assert_eq "scheme defaulted url" "https://example.com/path" "$(L info Bare | head -1 | cut -f2)"
assert_eq "existing scheme kept" "ok" "$(L add Plain http://plain.example)"
assert_eq "existing scheme kept url" "http://plain.example" "$(L info Plain | head -1 | cut -f2)"

# ================================================================ exec quoting
echo "# exec quoting"
roundtrip "space" Space 'https://s.example/a b?q=c d'
roundtrip "percent" Percent 'https://p.example/100%25%20done?x=%'
assert_contains "percent doubled in file" '%%25%%20done?x=%%' "$(exec_of Percent)"
roundtrip "double quote" Quote 'https://q.example/say"hi"'
assert_eq "quote escaped through both layers" 'omarchy-launch-browser "https://q.example/say\\"hi\\""' "$(exec_of Quote)"
roundtrip "dollar" Dollar 'https://d.example/$HOME/${x}'
assert_contains "dollar escaped through both layers" '\\$HOME/\\${x}' "$(exec_of Dollar)"
roundtrip "backtick" Tick 'https://t.example/`id`'
assert_contains "backtick escaped through both layers" '\\`id\\`' "$(exec_of Tick)"
roundtrip "backslash" Slash 'https://b.example/a\b\\c'
assert_contains "backslash quadrupled" 'a\\\\b\\\\\\\\c' "$(exec_of Slash)"
roundtrip "everything" All 'https://e.example/"$`\%  x'
assert_eq "everything is one list row" "1" "$(L list | grep -c -P '^All\t')"

# ================================================================ legacy entries
echo "# legacy entries"
printf '[Desktop Entry]\nName=Legacy\nExec=omarchy-launch-browser "https://l.example/say\\"hi\\"?p=%%%%"\nType=Application\nIcon=legacy\nX-Omarchy-Quicklink=true\n' >"$(entry Legacy)"
assert_eq "legacy single-layer entry still lists" $'Legacy\thttps://l.example/say"hi"?p=%\tlegacy\tfalse' "$(L list | grep -P '^Legacy\t')"
printf '[Desktop Entry]\nName=Broken\nExec=something-else x\nType=Application\nX-Omarchy-Quicklink=true\n' >"$(entry Broken)"
assert_eq "entry without our Exec skipped" "" "$(L list | grep -P '^Broken\t')"
printf '[Desktop Entry]\nName=Other\nExec=true\nType=Application\n' >"$(entry Other)"
assert_eq "non-quicklink skipped" "" "$(L list | grep -P '^Other\t')"
printf '[Desktop Entry]\nName=Unreadable\nExec=omarchy-launch-browser "https://u.example"\nType=Application\nX-Omarchy-Quicklink=true\n' >"$(entry Unreadable)"
chmod 000 "$(entry Unreadable)"
if [[ ! -r $(entry Unreadable) ]]; then
  assert_ok "list survives unreadable entry" L list
  assert_eq "unreadable entry skipped" "" "$(L list 2>/dev/null | grep -P '^Unreadable\t')"
fi
chmod 644 "$(entry Unreadable)"
rm -f "$(entry Unreadable)" "$(entry Broken)"

# ================================================================ collisions
echo "# collisions"
assert_fails "duplicate add refused" L add Invoices https://other.example
assert_eq "duplicate add message" 'a quicklink named "Invoices" already exists' "$(L add Invoices https://other.example 2>&1 >/dev/null)"
assert_eq "original intact" "https://books.example.com/invoices" "$(L info Invoices | head -1 | cut -f2)"
assert_fails "non-quicklink collision refused" L add Other https://other.example
assert_eq "non-quicklink collision message" '"Other" already exists and is not a quicklink' "$(L add Other https://other.example 2>&1 >/dev/null)"
assert_eq "non-quicklink untouched" $'[Desktop Entry]\nName=Other\nExec=true\nType=Application' "$(cat "$(entry Other)")"

# ================================================================ private
echo "# private"
assert_eq "add --private ok" "ok" "$(L add --private Secret https://secret.example)"
assert_eq "private in info" $'private\ttrue' "$(L info Secret | grep -P '^private\t')"
assert_eq "private in list" $'Secret\thttps://secret.example\tweb-browser\ttrue' "$(L list | grep -P '^Secret\t')"
assert_eq "private Exec" 'omarchy-launch-browser --private "https://secret.example"' "$(exec_of Secret)"
assert_contains "private marker present" $'\nX-Omarchy-Quicklink-Private=true' "$(cat "$(entry Secret)")"
assert_valid "desktop-file-validate private" Secret
assert_glib_cmdline "GLib private" Secret https://secret.example --private
assert_eq "flag after positionals" "ok" "$(L add Secret2 https://secret2.example --private)"
assert_eq "flag after positionals honoured" $'private\ttrue' "$(L info Secret2 | grep -P '^private\t')"

# ================================================================ open
echo "# open"
: >"$BROWSER_LOG"
assert_eq "open ok" "ok" "$(L open Invoices)"
settle
assert_eq "open passes url" "https://books.example.com/invoices" "$(cat "$BROWSER_LOG")"
: >"$BROWSER_LOG"
L open Secret >/dev/null; settle
assert_eq "open passes --private" $'--private\nhttps://secret.example' "$(cat "$BROWSER_LOG")"
: >"$BROWSER_LOG"
L open Quote >/dev/null; settle
assert_eq "open passes decoded url" 'https://q.example/say"hi"' "$(cat "$BROWSER_LOG")"
assert_fails "open missing" L open Nope
assert_fails "open non-quicklink" L open Other

# ================================================================ edit
echo "# edit"
mkdir -p "$OMARCHY_QUICKLINKS_ICON_DIR"
printf 'PNG' >"$(icon invoices)"
sed -i 's/^Icon=.*/Icon=invoices/' "$(entry Invoices)"
assert_eq "edit rename ok" "ok" "$(L edit Invoices --name Bills)"
assert_no_file "old entry gone" "$(entry Invoices)"
assert_file "new entry present" "$(entry Bills)"
assert_eq "renamed Name=" "Name=Bills" "$(grep '^Name=' "$(entry Bills)")"
assert_eq "renamed keeps url" "https://books.example.com/invoices" "$(L info Bills | head -1 | cut -f2)"
assert_eq "renamed icon follows" $'icon\tbills' "$(L info Bills | grep -P '^icon\t')"
assert_file "icon file renamed" "$(icon bills)"
assert_no_file "old icon file gone" "$(icon invoices)"
assert_valid "desktop-file-validate renamed" Bills
assert_fails "rename onto existing quicklink refused" L edit Bills --name Secret
assert_eq "rename conflict message" 'a quicklink named "Secret" already exists' "$(L edit Bills --name Secret 2>&1 >/dev/null)"
assert_fails "rename onto non-quicklink refused" L edit Bills --name Other
assert_file "conflict: source intact" "$(entry Bills)"
assert_file "conflict: target intact" "$(entry Secret)"
assert_fails "rename to bad name refused" L edit Bills --name "a/b"
assert_eq "rename to same name ok" "ok" "$(L edit Bills --name Bills)"
assert_file "same-name rename keeps entry" "$(entry Bills)"
# URL change on the same host keeps the icon and fetches nothing.
: >"$T/curl.log"
assert_eq "edit url ok" "ok" "$(L edit Bills --url https://books.example.com/bills)"
assert_eq "edit url applied" "https://books.example.com/bills" "$(L info Bills | head -1 | cut -f2)"
assert_eq "edit url keeps icon" $'icon\tbills' "$(L info Bills | grep -P '^icon\t')"
settle
assert_eq "same host: no refetch" "" "$(cat "$T/curl.log")"
# URL change to another host refetches.
assert_eq "edit url new host ok" "ok" "$(L edit Bills --url ledger.example.org/x)"
assert_eq "edit url normalized" "https://ledger.example.org/x" "$(L info Bills | head -1 | cut -f2)"
settle
assert_contains "new host: refetch attempted" "ledger.example.org" "$(cat "$T/curl.log")"
assert_eq "edit --private ok" "ok" "$(L edit Bills --private)"
assert_eq "edit --private applied" $'private\ttrue' "$(L info Bills | grep -P '^private\t')"
assert_eq "edit --private Exec" 'omarchy-launch-browser --private "https://ledger.example.org/x"' "$(exec_of Bills)"
assert_eq "edit --no-private ok" "ok" "$(L edit Bills --no-private)"
assert_eq "edit --no-private applied" $'private\tfalse' "$(L info Bills | grep -P '^private\t')"
assert_not_contains "private marker removed" "Private" "$(cat "$(entry Bills)")"
assert_eq "edit rename+url+private at once" "ok" "$(L edit Bills --name Ledger --url https://ledger.example.org/y --private)"
assert_eq "combined edit result" $'url\thttps://ledger.example.org/y\nicon\tledger\nprivate\ttrue' "$(L info Ledger)"
assert_file "combined edit icon renamed" "$(icon ledger)"
assert_fails "edit missing" L edit Nope --url https://x.example
assert_fails "edit non-quicklink" L edit Other --url https://x.example
assert_fails "edit unknown option" L edit Ledger --bogus
assert_fails "edit bad url" L edit Ledger --url $'a\tb'

# ================================================================ fetch-icon
echo "# fetch-icon"
# A curl that succeeds: the icon lands in ICON_DIR and Icon= is rewritten.
stub curl 'for a in "$@"; do [ "$prev" = -o ] && printf "PNG" >"$a"; prev=$a; done; exit 0'
assert_ok "fetch-icon exits 0" L fetch-icon Bare https://example.com/path
assert_file "fetched icon written" "$(icon bare)"
assert_eq "Icon= rewritten after fetch" "Icon=bare" "$(grep '^Icon=' "$(entry Bare)")"
assert_ok "fetch-icon for removed entry exits 0" L fetch-icon Ghost https://ghost.example
assert_file "orphan icon still written" "$(icon ghost)"
assert_no_file "no entry conjured for removed link" "$(entry Ghost)"
rm -f "$(icon ghost)"
assert_ok "fetch-icon without args exits 0" L fetch-icon
stub curl 'echo "$@" >>"'"$T"'/curl.log"; exit 22'
assert_ok "fetch-icon failing exits 0" L fetch-icon Plain http://plain.example
assert_eq "failed fetch leaves Icon= alone" "Icon=web-browser" "$(grep '^Icon=' "$(entry Plain)")"
assert_eq "failed fetch leaves no temp files" "" "$(ls -A "$OMARCHY_QUICKLINKS_ICON_DIR" | grep '^\.')"

# ================================================================ remove
echo "# remove"
assert_file "icon present before remove" "$(icon bare)"
assert_eq "remove ok" "ok" "$(L remove Bare)"
assert_no_file "remove deletes entry" "$(entry Bare)"
assert_no_file "remove deletes icon" "$(icon bare)"
assert_fails "remove missing" L remove Bare
assert_fails "remove non-quicklink refused" L remove Other
assert_file "non-quicklink survives remove" "$(entry Other)"

# ================================================================ any
echo "# any"
assert_ok "any with quicklinks" L any
mv "$OMARCHY_QUICKLINKS_DESKTOP_DIR" "$T/desktop.aside"
mkdir -p "$OMARCHY_QUICKLINKS_DESKTOP_DIR"
cp "$T/desktop.aside/Other.desktop" "$OMARCHY_QUICKLINKS_DESKTOP_DIR/"
assert_fails "any with only other apps" L any
assert_eq "list empty with only other apps" "" "$(L list)"
rm -rf "$OMARCHY_QUICKLINKS_DESKTOP_DIR"
assert_fails "any with no dir" L any
assert_eq "list with no dir" "" "$(L list)"
mv "$T/desktop.aside" "$OMARCHY_QUICKLINKS_DESKTOP_DIR"

# ================================================================ menu
echo "# menu-install / menu-uninstall"
mkdir -p "$(dirname "$OMARCHY_MENU_EXTENSION")"
printf '{\n  "custom": {"label":"Mine"}\n}\n' >"$OMARCHY_MENU_EXTENSION"
cp "$OMARCHY_MENU_EXTENSION" "$T/menu.orig"
touch "$OMARCHY_MENU_EXTENSION.bak.1700000000"
assert_eq "menu-install ok" "ok" "$(L menu-install)"
assert_contains "menu rows added" '"remove.quicklink"' "$(cat "$OMARCHY_MENU_EXTENSION")"
menu_now=$(cat "$OMARCHY_MENU_EXTENSION")
assert_contains "quicklinks is a submenu (no action)" '"quicklinks": {"icon":"󰌷","label":"Quicklinks"' "$menu_now"
assert_not_contains "submenu row carries no action" '"label":"Quicklinks","aliases":["quicklink","links","bookmarks"],"description":"Saved links that open in your default browser","when":"[ -x '"'"'$LAYOUTS'"'"' ]","action"' "$menu_now"
assert_contains "manage row opens the panel" '"quicklinks.manage": {"icon":"󰒓","label":"Manage quicklinks"' "$menu_now"
assert_contains "one row per link, launch inlined" '"quicklinks.trimmed": {"icon":"󰌷","label":"Trimmed","description":"https://t.example","when":"[ -f '"'"''"$OMARCHY_QUICKLINKS_DESKTOP_DIR"'/Trimmed.desktop'"'"' ]","action":"omarchy-launch-browser '"'"'https://t.example'"'"'"}' "$menu_now"
# Our block must be valid JSON on its own: rows between the markers, comments
# dropped, trailing comma tolerated as Omarchy's JSONC reader does.
menu_json_ok() {
  python3 - "$1" <<'PY'
import sys, re, json
raw = open(sys.argv[1]).read()
block = raw.split("// >>> omarchy-quicklinks", 1)[1].split("\n", 1)[1].split("// <<< omarchy-quicklinks", 1)[0]
block = re.sub(r'^\s*//.*$', '', block, flags=re.M).strip().rstrip(',')
json.loads('{' + block + '}')
PY
}
assert_ok "menu block is valid JSON" menu_json_ok "$OMARCHY_MENU_EXTENSION"
assert_contains "guard uses any" "'$Q' any" "$(cat "$OMARCHY_MENU_EXTENSION")"
assert_not_contains "guard no longer greps applications" "grep" "$(cat "$OMARCHY_MENU_EXTENSION")"
assert_contains "existing rows kept" '"custom"' "$(cat "$OMARCHY_MENU_EXTENSION")"
cp "$OMARCHY_MENU_EXTENSION" "$T/menu.once"
assert_eq "menu-install again ok" "ok" "$(L menu-install)"
assert_ok "menu-install idempotent" cmp -s "$T/menu.once" "$OMARCHY_MENU_EXTENSION"
assert_eq "single .bak, legacy pruned" "1" "$(ls "$(dirname "$OMARCHY_MENU_EXTENSION")" | grep -c '\.bak')"
# Rows follow the entries: add/edit/remove regenerate them.
L add "Menu Link" https://menu.example --private --icon web-browser >/dev/null
assert_contains "add regenerates rows with private glyph and flag" '"quicklinks.menu-link": {"icon":"󰒃","label":"Menu Link","description":"https://menu.example","when":"[ -f '"'"''"$OMARCHY_QUICKLINKS_DESKTOP_DIR"'/Menu Link.desktop'"'"' ]","action":"omarchy-launch-browser --private '"'"'https://menu.example'"'"'"}' "$(cat "$OMARCHY_MENU_EXTENSION")"
L add "menu link" https://other.example --icon web-browser >/dev/null
assert_contains "slug collisions stay unique" '"quicklinks.menu-link-2": {"icon":"󰌷","label":"menu link"' "$(cat "$OMARCHY_MENU_EXTENSION")"
L remove "menu link" >/dev/null
assert_not_contains "remove drops the row" 'quicklinks.menu-link-2' "$(cat "$OMARCHY_MENU_EXTENSION")"
L edit "Menu Link" --name "Renamed Link" >/dev/null
assert_contains "edit renames the row" '"quicklinks.renamed-link"' "$(cat "$OMARCHY_MENU_EXTENSION")"
assert_not_contains "edit drops the old row" '"quicklinks.menu-link"' "$(cat "$OMARCHY_MENU_EXTENSION")"
assert_ok "menu block still valid JSON after churn" menu_json_ok "$OMARCHY_MENU_EXTENSION"
assert_contains "entries are NoDisplay" "NoDisplay=true" "$(cat "$(entry "Renamed Link")")"
assert_contains "entries carry GenericName" "GenericName=Quicklink" "$(cat "$(entry "Renamed Link")")"
# sync upgrades an entry written by an older version and mirrors it in the menu.
printf '[Desktop Entry]\nName=Legacy2\nExec=omarchy-launch-browser "https://legacy2.example"\nType=Application\nIcon=web-browser\nX-Omarchy-Quicklink=true\n' >"$(entry Legacy2)"
assert_eq "sync ok" "ok" "$(L sync)"
assert_contains "sync adds NoDisplay to legacy entry" "NoDisplay=true" "$(cat "$(entry Legacy2)")"
assert_eq "sync keeps legacy URL" "https://legacy2.example" "$(L info Legacy2 | grep '^url' | cut -f2)"
assert_contains "sync mirrors legacy entry in menu" '"quicklinks.legacy2"' "$(cat "$OMARCHY_MENU_EXTENSION")"
cp "$OMARCHY_MENU_EXTENSION" "$T/menu.synced"
L sync >/dev/null
assert_ok "sync is idempotent" cmp -s "$T/menu.synced" "$OMARCHY_MENU_EXTENSION"
assert_eq "menu-uninstall ok" "ok" "$(L menu-uninstall)"
assert_ok "menu-uninstall restores original" cmp -s "$T/menu.orig" "$OMARCHY_MENU_EXTENSION"
assert_eq "still a single .bak after uninstall" "1" "$(ls "$(dirname "$OMARCHY_MENU_EXTENSION")" | grep -c '\.bak')"

# ================================================================ export / import
echo "# export / import"
# Icons the plugin fetched itself (named after the entry) are not exported;
# a themed icon the user picked is.
sed -i 's/^Icon=.*/Icon=ledger/' "$(entry Ledger)"
export_json=$(L export -)
assert_ok "export - is valid JSON" jq -e . <<<"$export_json"
assert_eq "export format" "omarchy-quicklinks" "$(jq -r .format <<<"$export_json")"
assert_eq "export version" "1" "$(jq -r .version <<<"$export_json")"
assert_eq "export count matches list" "$(L list | wc -l)" "$(jq '.quicklinks | length' <<<"$export_json")"
assert_eq "export raw url survives" 'https://q.example/say"hi"' "$(jq -r '.quicklinks[] | select(.name == "Quote") | .url' <<<"$export_json")"
assert_eq "export private flag" "true" "$(jq -r '.quicklinks[] | select(.name == "Ledger") | .private' <<<"$export_json")"
assert_eq "export omits fetched icon" "null" "$(jq -r '.quicklinks[] | select(.name == "Ledger") | .icon' <<<"$export_json")"
assert_eq "export omits fallback icon" "null" "$(jq -r '.quicklinks[] | select(.name == "Plain") | .icon' <<<"$export_json")"
assert_eq "export keeps chosen icon" "my-icon" "$(jq -r '.quicklinks[] | select(.name == "Iconed") | .icon' <<<"$export_json")"
mkdir -p "$HOME/Downloads"
out=$(L export)
assert_eq "export default path" "$HOME/Downloads/omarchy-quicklinks-$(date +%Y-%m-%d).json" "$out"
assert_file "export default file written" "$out"
assert_fails "export refuses to overwrite" L export
assert_eq "export --force overwrites" "$out" "$(L export --force)"
assert_eq "export to given path" "$T/mine.json" "$(L export "$T/mine.json")"
assert_ok "export file is valid JSON" jq -e . "$T/mine.json"
assert_eq "export into a directory" "$T/Downloads-like/$(basename "$out")" "$(mkdir -p "$T/Downloads-like"; L export "$T/Downloads-like")"
assert_eq "export leaves no temp files" "" "$(ls -A "$T/Downloads-like" | grep '^\.')"
assert_eq "empty export leaves no temp files" "" "$(ls -A "$HOME/Downloads" | grep '^\.')"
# Import into a fresh tree: everything comes back, private and icon intact.
mv "$OMARCHY_QUICKLINKS_DESKTOP_DIR" "$T/desktop.pre-import"
before=$(cd "$T/desktop.pre-import" && grep -l "$MARKER_LINE" *.desktop | wc -l)
assert_eq "import ok" "imported $before skipped 0" "$(L import "$T/mine.json")"
assert_eq "import restores list" "$(jq -r '.quicklinks[] | .name' "$T/mine.json" | sort -f)" "$(L list | cut -f1 | sort -f)"
assert_eq "import restores raw url" 'https://q.example/say"hi"' "$(L info Quote | head -1 | cut -f2)"
assert_eq "import restores private" $'private\ttrue' "$(L info Ledger | grep -P '^private\t')"
assert_eq "import restores chosen icon" $'icon\tmy-icon' "$(L info Iconed | grep -P '^icon\t')"
assert_eq "import refetches dropped icon" $'icon\tweb-browser' "$(L info Ledger | grep -P '^icon\t')"
assert_eq "import again skips duplicates" "imported 0 skipped $before" "$(L import "$T/mine.json")"
L edit Quote --url https://changed.example >/dev/null
assert_eq "import --replace overwrites" "imported $before skipped 0" "$(L import "$T/mine.json" --replace)"
assert_eq "import --replace restored url" 'https://q.example/say"hi"' "$(L info Quote | head -1 | cut -f2)"
printf '[{"name":"Bare Array","url":"bare.example"},{"name":"a/b","url":"x"},{"url":"nameless"},"junk"]\n' >"$T/bare.json"
assert_eq "import bare array, bad rows skipped" "imported 1 skipped 1" "$(L import "$T/bare.json")"
assert_eq "import normalizes url" "https://bare.example" "$(L info "Bare Array" | head -1 | cut -f2)"
assert_fails "import missing file" L import "$T/nope.json"
assert_fails "import non-json" L import "$(entry Plain)"
assert_fails "import needs a file" L import
settle
rm -rf "$OMARCHY_QUICKLINKS_DESKTOP_DIR"
mv "$T/desktop.pre-import" "$OMARCHY_QUICKLINKS_DESKTOP_DIR"

# ================================================================ uninstall
echo "# uninstall"
# Rows present, our .bak present, a legacy .bak.<epoch> lying around.
L menu-install >/dev/null
touch "$OMARCHY_MENU_EXTENSION.bak.1700000001"
cp "$OMARCHY_MENU_EXTENSION" "$OMARCHY_MENU_EXTENSION.bak"
assert_contains "rows present before uninstall" "omarchy-quicklinks" "$(cat "$OMARCHY_MENU_EXTENSION")"
assert_eq "uninstall --keep-quicklinks ok" "removed menu rows and backups; quicklinks kept" "$(L uninstall --keep-quicklinks)"
assert_ok "uninstall restores menu file" cmp -s "$T/menu.orig" "$OMARCHY_MENU_EXTENSION"
assert_eq "uninstall removes our .bak and legacy backups" "" "$(ls "$(dirname "$OMARCHY_MENU_EXTENSION")" | grep '\.bak')"
assert_ok "--keep-quicklinks keeps quicklinks" L any
assert_file "--keep-quicklinks keeps entries" "$(entry Plain)"
assert_ok "uninstall is idempotent" L uninstall --keep-quicklinks
# A .bak that is not ours (no quicklinks rows in it) is left alone.
L menu-install >/dev/null
printf '{\n  "theirs": {"label":"x"}\n}\n' >"$OMARCHY_MENU_EXTENSION.bak"
L uninstall --keep-quicklinks >/dev/null
assert_file "uninstall leaves a foreign .bak" "$OMARCHY_MENU_EXTENSION.bak"
rm -f "$OMARCHY_MENU_EXTENSION.bak"
# menu-install created the extension file itself: uninstall takes it away again,
# with the directory.
rm -rf "$(dirname "$OMARCHY_MENU_EXTENSION")"
L menu-install >/dev/null
assert_file "menu-install created the extension file" "$OMARCHY_MENU_EXTENSION"
L uninstall --keep-quicklinks >/dev/null
assert_no_file "uninstall removes the file it created" "$OMARCHY_MENU_EXTENSION"
assert_no_file "uninstall removes the directory it created" "$(dirname "$OMARCHY_MENU_EXTENSION")"
# menu-uninstall behaves the same for a file it created.
L menu-install >/dev/null
L menu-uninstall >/dev/null
assert_no_file "menu-uninstall removes the file it created" "$OMARCHY_MENU_EXTENSION"
# Default: entries and icons go, other apps and their files stay, empty dirs go.
mkdir -p "$OMARCHY_QUICKLINKS_ICON_DIR"
printf 'PNG' >"$(icon plain)"; sed -i 's/^Icon=.*/Icon=plain/' "$(entry Plain)"
printf 'PNG' >"$(icon other)"
n=$(L list | wc -l)
assert_eq "uninstall default ok" "removed $n quicklink(s), menu rows and backups" "$(L uninstall)"
assert_fails "purge leaves no quicklinks" L any
assert_no_file "purge deletes entry" "$(entry Plain)"
assert_no_file "purge deletes fetched icon" "$(icon plain)"
assert_file "purge keeps a non-quicklink entry" "$(entry Other)"
assert_file "purge keeps an icon it did not fetch" "$(icon other)"
[[ -d $OMARCHY_QUICKLINKS_DESKTOP_DIR ]] && ok || ko "purge keeps non-empty dirs"
rm -f "$(entry Other)" "$(entry Legacy)" "$(icon other)"
L uninstall >/dev/null
assert_no_file "purge removes the emptied icon dir" "$OMARCHY_QUICKLINKS_ICON_DIR"
assert_no_file "purge removes the emptied desktop dir" "$OMARCHY_QUICKLINKS_DESKTOP_DIR"
assert_eq "nothing of ours left in scratch" "" "$(grep -rl 'omarchy-quicklinks\|X-Omarchy-Quicklink' "$T" --exclude-dir=bin --exclude-dir=Downloads --exclude-dir=Downloads-like --exclude=mine.json --exclude=bare.json --exclude='menu.*' 2>/dev/null)"
assert_fails "uninstall unknown option" L uninstall --bogus
assert_fails "uninstall --purge is gone" L uninstall --purge
# --remove-plugin hands off to omarchy plugin remove with --yes.
stub omarchy 'echo "$@" >>"'"$T"'/omarchy.log"'
: >"$T/omarchy.log"
assert_ok "uninstall --remove-plugin exits 0" L uninstall --remove-plugin
assert_contains "--remove-plugin calls omarchy plugin remove --yes" "plugin remove micull199.quicklinks --yes" "$(cat "$T/omarchy.log")"
stub omarchy 'exit 0'

# ================================================================ usage
echo "# usage"
assert_fails "unknown command" L bogus
assert_contains "usage mentions edit" "edit" "$(L bogus 2>&1)"
assert_contains "usage mentions any" "any" "$(L bogus 2>&1)"
assert_contains "usage mentions export" "export" "$(L bogus 2>&1)"
assert_contains "usage mentions uninstall" "uninstall" "$(L bogus 2>&1)"

echo
echo "passed: $pass  failed: $fail"
((fail == 0))
